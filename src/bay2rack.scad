// =====================================================================
//  bay2rack - 5.25" drive bay  ->  6" mini rack adapter (parametric)
//  License: CC BY-NC-SA 4.0 - see LICENSE
//
//  Units: mm.  Axes (assembly view):
//    X = width, Y = depth (+Y goes INTO the case), Z = height.
//    Y = 0 is the case front plane = front of a drive's metal chassis
//          (bay holes are measured from it) = back face of the front frame.
//    Z = 0 is the bottom of the lowest bay used.
//
//  This file only holds the parameters; the geometry lives in lib/.
//  Works with the OpenSCAD Customizer (Window > Customizer) and with the
//  presets in bay2rack.json (generated by scripts/build.py).
//  Values marked VERIFY are best-known defaults: measure your own case
//  and rack gear.
// =====================================================================

/* [Part to render] */
// What to render. "assembly" is a preview only, do not print it.
part = "assembly"; // [assembly:Assembly preview, adapter:Adapter - frame + sleeve, filler:Spare-zone filler panel, filler_2:Second filler - split mode, rack_panel:Standalone rack panel, rack_module:Rack module - one U of the rack contents, rack_module_lid:Lid of a NanoKVM bay module, rack_module_bay:Pocket of a split NanoKVM bay (nkvm_split), filler_labels:Multicolour letters of the filler, rack_module_labels:Multicolour letters of a rack module, rack_panel_labels:Multicolour letters of the rack panel, keystone_cover:Keystone cover - plain or cable pass-through, pci_bracket:Rear PCI-slot bracket - cable or power pass-through, test_rack:Test - rack hole spacing bar, test_bay:Test - bay screw corner, test_keystone:Test - keystone coupon]
// Lay printable parts front-face down on the bed
print_orientation = true;

/* [Drive bays] */
// Number of stacked 5.25" bays the adapter fills
bays = 3; // [1:1:6]
// Bay standard
bay_std = "sff"; // [sff:5.25in - SFF-8551 / EIA-741, custom:Custom]
custom_bay_w = 146.05; // [120:0.05:160]
custom_bay_h = 41.53; // [30:0.01:50]
// Bay-to-bay vertical pitch in a stacked cage (VERIFY)
custom_bay_pitch = 43.18; // [35:0.01:50]
// Width of a 5.25in drive bezel
custom_bezel_w = 148.0; // [130:0.1:160]
// Removed from the sleeve's total width
sleeve_clearance = 0.3; // [0:0.05:1.5]
// Removed from the stack height
height_clearance = 0.4; // [0:0.05:2]
// Side hole distance from the case front plane (VERIFY)
bay_hole_y1 = 47.40; // [5:0.05:200]
// Optional rear side hole (VERIFY)
bay_hole_y2 = 126.65; // [5:0.05:200]
use_hole_y2 = false;
// Side hole height above each bay's bottom (VERIFY)
bay_hole_z1 = 10.0; // [2:0.01:40]
bay_hole_z2 = 21.84; // [2:0.01:40]
use_hole_z2 = false;
// Shift all side holes in depth
bay_hole_offset = 0; // [-20:0.1:20]
// Elongate side holes along depth (ignored for heat-set)
bay_hole_slot = 0; // [0:0.5:10]

/* [Front style] */
// plate = flat frame behind the rack panels.  bezel = exact 5.25in drive bezel, flush with the case front like an original drive
front_style = "plate"; // [plate:Plate frame, bezel:Exact 5.25in drive bezel]
// Single-bay drive bezel height (SFF-8551 - VERIFY)
bezel_h1 = 42.30; // [35:0.01:50]
// How far a drive bezel sits in front of the drive chassis = how deep your case front is (VERIFY)
bezel_depth = 8.0; // [2:0.5:25]
// Removed from bezel width and height so it slips into the case opening
bezel_clearance = 0.3; // [0:0.05:1.5]
// Cosmetic grooves where stacked drive bezels would meet
bezel_grooves = true;

/* [Fit mode] */
// flush = N-1 U + spare zone, nothing sticks out.  overhang = N bays = N U, rack panels stick out a few mm above/below
fit = "flush"; // [flush:Flush - inside the bay stack, overhang:Overhang - N bays = N U, panel:Panel only - no rack units / the whole front is the fill]
// Rack units to provide (0 = automatic)
units_override = 0; // [0:1:6]
// Where the extra height goes when there is no spare zone
overhang_align = "center"; // [center, top, bottom]
// Where the spare zone goes
spare_pos = "top"; // [top, bottom, split]
// split: share of the spare height that goes to the bottom zone
spare_split = 0.5; // [0.2:0.01:0.8]
// Spare zones smaller than this become plain frame rim
min_spare = 4; // [0:0.5:20]

/* [Rack standard] */
// 6in wide, built with the 10in mini rack rules: EIA-310 holes, 1U = 44.45, same 8.74 mm edge-to-hole inset
rack_std = "6in"; // [6in:6in - 10in mini rack conventions, custom:Custom]
custom_panel_w = 152.4; // [120:0.1:260]
// Horizontal centre-to-centre distance between rack holes
custom_hole_spacing = 134.9; // [100:0.05:245]
// Height of one rack unit
rack_u_h = 44.45; // [40:0.01:50]
hole_pattern = "auto"; // [auto:Auto - EIA inside the bays / centre when the units stick out, eia:EIA-310 - 3 holes per U, eia_outer:2 holes per U - outer, center:1 hole per U - centre, none:No holes]

/* [Rack hardware] */
// 10in mini rack convention: M6, 10-32 or 12-24
rack_screw = "M6"; // [M3, M4, M5, M6, 10-32, 12-24]
rack_screw_head = "button"; // [button:Button head - ISO 7380, socket:Socket head - ISO 4762, countersunk:Countersunk - ISO 10642, pan:Pan head - ISO 7045]
// Screw length in mm (0 = pick the right standard length automatically)
rack_screw_len = 0; // [0:1:40]
rack_fixing = "heatset"; // [heatset:Heat-set inserts, tap:Self-tapping pilot hole, nut_trap:Hex nut trap - back, square_nut:Square nut side slot, channel:Sliding square-nut channel - any height]
// Hole for your heat-set insert (0 = table value)
rack_insert_d = 0; // [0:0.05:12]
// Length of your heat-set insert (0 = table value)
rack_insert_l = 0; // [0:0.1:20]
// Ear thickness of your rack accessories (for screw length)
accessory_panel_t = 2.5; // [0.5:0.1:8]
// Horizontal elongation of rack holes, absorbs spacing differences (clearance-based fixings only)
rack_hole_slot = 0; // [0:0.5:6]

/* [Bay hardware] */
bay_screw = "M3"; // [M3, 6-32]
bay_screw_head = "pan"; // [pan:Pan head, button:Button head, socket:Socket head, countersunk:Countersunk]
// Screw length in mm (0 = automatic)
bay_screw_len = 0; // [0:1:20]
bay_fixing = "heatset"; // [heatset:Heat-set insert, tap:Self-tapping pilot hole, nut:Hex nut pocket inside, clearance:Plain clearance + loose nut, none:No holes]
bay_insert_d = 0; // [0:0.05:8]
bay_insert_l = 0; // [0:0.1:12]
// Sheet thickness of your drive cage (for screw length)
case_wall_t = 0.8; // [0.3:0.05:3]

/* [Frame and sleeve] */
// Front frame width (0 = bezel width, 148)
frame_w_override = 0; // [0:0.5:160]
// Plate-style frame thickness (bezel style uses bezel_depth)
frame_t = 4; // [2:0.5:10]
frame_chamfer = 0.8; // [0:0.1:2]
// Rim kept above/below every opening
frame_rim = 2.5; // [1:0.5:8]
// Depth of the rack-screw posts behind the frame
post_d = 10; // [6:0.5:25]
wall_t = 2.4; // [1.2:0.1:5]
// How deep the sleeve goes into the bay
sleeve_depth = 62; // [20:1:200]
sleeve_style = "rails"; // [rails:Side rails only, box:Side + top and bottom plates]
// Grooves for the metal tabs between the bays (the ledges the CD drives rest on), so you don't have to bend them flat
bay_tabs = true;
// Groove height, centred on the gap between two bays
bay_tab_h = 5; // [2:0.5:10]
// How far the tabs stick into the bay (the wall gets a rib inside to keep 1.2 mm behind the groove)
bay_tab_d = 3; // [0.5:0.5:6]
// Cut print-friendly windows in walls and plates
lighten = true;
// Stiffen the side walls that screw to the case: an inner lip along their top and bottom edge and a fillet into each rack post (all outside the rack opening, nothing in the rack touches them)
wall_ribs = true;
// Width of the inner lips
wall_lip = 6; // [2:0.5:15]

/* [Spare-zone filler] */
// separate = screw-on panel you can swap (modular).  integral = features cut into the frame
filler_mode = "separate"; // [separate:Separate screw-on panel, integral:Cut into the frame]
spare_fill = "keystone"; // [blank, keystone, vent, cable, led, label, buttons, fan40, fan80]
// Fill of the top zone when spare_pos = split
spare_fill_2 = "vent"; // [blank, keystone, vent, cable, led, label, buttons, fan40, fan80]
filler_t = 3; // [1.5:0.5:6]
label_text = "HOMELAB";
// Vent fill: the pattern, and the solid rim left round it at the sides
vent_style = "slots"; // [slots:Vertical slots, louvres:Louvres - slanted slots, hex:Honeycomb, dots:Round holes]
vent_margin = 8; // [2:1:40]
// Label: letter height (0 = as big as the zone allows), alignment and shift
label_size = 0; // [0:0.5:30]
label_align = "center"; // [left, center, right]
label_dx = 0; // [-70:0.5:70]
label_dz = 0; // [-20:0.5:20]
// engraved = letters cut into the panel; raised = the letters stand out of a recessed band (prints flat, no supports)
label_relief = "engraved"; // [engraved:Engraved - into the panel, raised:Raised - out of the panel]
label_depth = 0.8; // [0.4:0.1:2]
label_bold = true;
// Multicolour: the letters of the labels and port names come as a separate piece (part = ..._labels) to print in another filament
labels_multicolour = false;

/* [Keystone patch] */
// metal = holder cells for metal / shielded keystones (shape of the original design).  standard = plain cut-out for plastic keystones
ks_style = "metal"; // [metal:Metal / shielded keystone - holder cells, standard:Standard plastic keystone - cut-out]
ks_ports = 6; // [1:1:12]
// Type of every port, comma separated (empty = ks_ports x ks_style): rj45m = metal RJ45 cell, rj45 hdmi usb rca jack toslink = standard keystones, cover = plain cover, pass = cable pass-through cover, none = no hole
ks_ports_list = "rj45m,rj45m,rj45m,cover,cover,pass";
ks_labels = true;
// Names over the ports, comma separated in port order (e.g. WAN,LAN 1,NAS,,PC). An empty one shows the type for HDMI / USB / RCA / audio / optical jacks, else the next number
ks_names = "";
ks_label_start = 1; // [0:1:99]
// Fit of every keystone opening (holder cells, cut-outs, covers follow): print test_keystone first; raise it if the jack does not go in or clip, lower it (negative) if it rattles
ks_fit = 0; // [-0.5:0.05:0.8]

/* [Keystone - metal holder cell] */
// Cavity width
ksm_w = 15.0; // [13:0.05:18]
// Front opening height
ksm_face_h = 16.5; // [14:0.05:19]
// 45 deg chamfer under the front opening
ksm_chamfer = 2.0; // [0:0.1:4]
// Cavity height behind the opening
ksm_cav_h = 24.3; // [20:0.05:30]
// Depth where the latch ramp reaches the cavity top
ksm_ramp_d = 4.87; // [2:0.05:9]
// Depth where the rear lips start
ksm_lip_d = 8.05; // [5:0.05:12]
// Rear lip heights (they catch the jack)
ksm_lip_top = 2.0; // [0.5:0.1:4]
ksm_lip_bot = 2.5; // [0.5:0.1:4]
// Total cell depth from the front face
ksm_depth = 9.5; // [6:0.1:14]
ksm_wall = 2.0; // [1.2:0.1:4]
ksm_pitch = 20.0; // [16:0.5:30]

/* [Keystone - standard cut-out] */
// Cut-out (standard jack ~14.5 x 16.0)
ks_w = 14.9; // [13:0.05:17]
ks_h = 16.4; // [14:0.05:19]
ks_pitch = 19.0; // [16:0.5:30]
// Plate thickness where the jack clips in
ks_plate_t = 2.0; // [1:0.1:3]

/* [Keystone covers] */
// Printed covers for unused ports, pushed in from the front (part = keystone_cover)
cover_type = "blank"; // [blank:Plain cover, pass:Cable pass-through - split so it clips around a cable]
// Clearance per side in the port
cover_clear = 0.25; // [0:0.05:0.8]
// Cable diameter for the pass-through
cover_cable_d = 6.5; // [3:0.5:12]

/* [Button panel] */
// Power / reset keys use normal keyboard switches (Cherry MX compatible: 14 mm cut-out, 1.5 mm plate)
btn_count = 2; // [1:Power only, 2:Power + reset]
mx_cut = 14.0; // [13.5:0.05:14.5]
mx_plate_t = 1.5; // [1.2:0.1:2]
// Power and disk-activity LEDs
led_d = 3; // [3:3 mm, 5:5 mm]
// halo = light ring around each key. ring = countersunk hole with an engraved ring and the LED dome sticking out. glow = hidden: the light shines through a thin skin and the engraved icon lights up
led_style = "ring"; // [ring:Countersunk ring - the LED dome sticks out, halo:Halo ring of light around each key, glow:Hidden glow - the icon lights up through a thin skin]
// How far the LED dome sticks out of the front (ring style)
led_protrude = 1.5; // [0:0.1:4]

/* [Rack contents] */
// What goes in the rack, top first (assembly preview and kit): ms105g, kvm, pi, piblade (2U), nkvm, uswflex, ux, dev1, dev2, shelf, patch, fan40, buttons, vent, blank, cable, led, label. kvm and pi trays name their boxes after a colon, joined with +: kvm:jet+nano, kvm:nano+nano, pi:pi5, pi:pi4+pi4, piblade:pi5+pi5+pi5, nkvm:side, nkvm:front
rack_modules = "ms105g,kvm:jet+nano";
// Module made by part = rack_module
module_type = "ms105g"; // [ms105g:Mercusys MS105G switch mount, kvm:KVM over IP tray - 1 to 3 boxes (kvm_boxes), pi:Raspberry Pi tray - 1 or 2 boards flat (pi_boards), piblade:2U Raspberry Pi blades - up to 4 boards on edge (pi_boards), uswflex:UniFi USW-Flex-Mini switch mount, ux:UniFi Express mount, nkvm:NanoKVM bay with lid (nkvm:side standing in a front pocket - heatsink to the front - Ethernet left - HDMI and USB right / nkvm:front lying flat - only Ethernet at the front), dev1:Your device 1 - dev1_dims, dev2:Your device 2 - dev2_dims, shelf:1U shelf for small devices, patch:1U keystone patch panel, fan40:1U panel with 40 mm fans, vent:1U vented panel, blank:1U blank panel, cable:1U cable pass-through, led:1U LED strip, label:1U engraved label, buttons:1U button panel - power and reset]

/* [Device mounts] */
// Mercusys MS105G 5-port switch, W x H x D from retailer spec sheets (VERIFY)
ms_w = 105; // [50:0.1:125]
ms_h = 24.9; // [10:0.1:40]
ms_d = 70; // [20:1:200]
// Clearance around the device (also round the NanoKVM in its bay): raise it if the device does not slide in
mount_clear = 0.6; // [0:0.1:2]
// Lip around the front window that stops the device
mount_lip = 1.5; // [0.5:0.5:5]
mount_wall = 2.0; // [1.2:0.1:4]
// Shelf depth for small devices (NanoKVM, Raspberry Pi...)
shelf_depth = 100; // [30:1:200]
// Boxes of the KVM tray made by part = rack_module, left to right, joined with + (1 to 3 if they fit): jet = JetKVM, nano = Sipeed NanoKVM, custom = kvm_custom
kvm_boxes = "jet+nano";
// JetKVM, W x H x D (press / retailer figures - VERIFY)
jetkvm_dims = [43, 31, 60]; // [5:0.1:200]
// Sipeed NanoKVM Full (with its case), W x H x D (VERIFY)
nanokvm_dims = [40, 36, 40]; // [5:0.1:200]
// Any other KVM box for the KVM tray (custom), W x H x D
kvm_custom = [50, 25, 60]; // [5:0.1:200]
// NanoKVM bay (module nkvm:side or nkvm:front): Sipeed NanoKVM Lite lying flat, length (Ethernet end to HDMI / USB end) x height x width (VERIFY)
nkvm_dims = [37, 15, 23]; // [10:0.1:80]
// Its Ethernet port: width, height, height above the bottom of the board (nkvm:front cuts it through the plate)
nkvm_rj45 = [16, 13.5, 1]; // [0:0.1:20]
// Keystone openings on the left of the NanoKVM bay
nkvm_keystones = 0; // [0:1:2]
// nkvm:side - room in the pocket for the plugs: Ethernet on the left, HDMI / USB on the right
nkvm_plugs = [32, 42]; // [0:1:60]
// nkvm:side - the plate covers the pocket beside the NanoKVM, so the plugs and the inside of the case are hidden (off = the whole pocket is open)
nkvm_cover = true;
// nkvm:side - vent slots in the covered sides of the plate
nkvm_vents = true;
// nkvm:side - three pieces: the plate and the pocket printed apart and screwed together (M3 heat-set inserts)
nkvm_split = false;
// Hole for the M3 heat-set inserts of the NanoKVM bay (0 = 4.2 mm table value): raise it if the insert melts in crooked, lower it if it spins
nkvm_insert_d = 0; // [0:0.05:5]
// Boards of the Raspberry Pi tray made by part = rack_module, joined with +: pi5, pi4, pi3 (3B / 3B+), zero (Zero / Zero 2 W). The flat tray takes 1 or 2, the 2U blade tray up to 4 (not Zero)
pi_boards = "pi5";
// Blade tray: distance between boards (26 fits a Pi 5 with the active cooler, use ~32 with PoE HATs)
pi_blade_pitch = 26; // [18:0.5:45]
// How the boards are screwed to the standoffs
pi_fixing = "selftap"; // [selftap:M2.5 self-tapping screws, heatset:M2.5 heat-set inserts]
// Standoff height under the boards
pi_standoff = 5; // [2:0.5:12]
// UniFi USW-Flex-Mini, W x H x D (Ubiquiti spec)
usw_dims = [107.2, 21.2, 70.2]; // [5:0.1:200]
// UniFi Express (UX), W x H x D (Ubiquiti spec)
ux_dims = [98, 30, 98]; // [5:0.1:200]
// Your own device for the dev1 module, W x H x D
dev1_dims = [100, 30, 80]; // [5:0.1:200]
// Your own device for the dev2 module, W x H x D
dev2_dims = [60, 25, 60]; // [5:0.1:200]

/* [Fans] */
// Opening in front of the fans: open = plain round hole, hex = hex grille
fan_guard = "open"; // [open:Open round hole, hex:Hex grille]
// 40 mm fans side by side in a fan40 module or fill
fan40_count = 3; // [1:1:3]
// Fan thickness (40 x 40 x 10 or x 20); sets the screw length
fan40_t = 10; // [10, 20]

/* [Rear cable slots] */
// Printed brackets that replace two PCI slot covers: the network cables and the power cable leave the case through them
rear_slots = true;
// PCI slot used by the network cables (0 = top)
pci_lan_slot = 5; // [0:1:6]
// PCI slot used by the power cable
pci_power_slot = 6; // [0:1:6]
// Bracket made by part = pci_bracket
pci_kind = "lan"; // [lan:Network cables - keyhole slot, power:Power cable - round hole + strain relief]
// Bracket thickness (steel ones are ~0.9 mm, most cases take 2 mm)
pci_t = 2.0; // [0.8:0.1:3]

/* [Standalone rack panel] */
panel_u = 1; // [1:1:4]
panel_fill = "keystone"; // [blank, keystone, vent, cable, led, label, buttons, fan40, fan80]
panel_t = 3; // [2:0.5:6]
// Horizontal slotting of panel holes
panel_hole_slot = 2; // [0:0.5:6]

/* [Preview] */
explode = 0; // [0:1:60]
// Show the adapter mounted in a PC case
case_view = "tower"; // [none:No case, ghost:Transparent bay sheets only, tower:PC tower case]
// Real PC case for the preview (approximate outer size). auto = the smallest one with enough 5.25in bays
case_model = "auto"; // [auto:Auto - smallest case that fits, definer5:Fractal Design Define R5 - 2 bays, obsidian750d:Corsair Obsidian 750D - 3 bays, antec300:Antec Three Hundred - 3 bays, enthoopro:Phanteks Enthoo Pro - 3 bays, definexlr2:Fractal Design Define XL R2 - 4 bays, haf932:Cooler Master HAF 932 - 5 bays, stacker830:Cooler Master Stacker 830 - 11 bays]
// Transparent side panel of the preview tower
case_window = "left"; // [left, right, none]
show_devices = true;
// Show the devices in the rack modules (switch, NanoKVM, keystone jacks)
demo_devices = "homelab"; // [homelab:Devices + keystone jacks, generic:Empty modules]
// homelab = two client PCs + access point + network cables around this PC
scene = "single"; // [single:Just this PC, homelab:Homelab - two client PCs + access point + cables]
// Homelab scene: this PC is the router, with a 4-port network card in this expansion slot (0 = top, -1 = none)
router_nic_slot = 1; // [-1:1:6]
// Draw screws, inserts and nuts
show_hardware = true;
// Cut the assembly open to see the hardware inside
section = "none"; // [none:No cut, rack_row:Horizontal cut through a rack hole row, rack_column:Vertical cut through the right rack holes, bay:Cut through the bay screws]

/* [Hidden] */
// set by the web viewer: OpenSCAD only echoes the scene (case, clients, cables) as data
web_scene = false;
// web viewer: render a single piece of the assembly (adapter, filler, module, hardware) so it can be animated
preview_item = "all";
preview_index = 0;
$fn = 40;
eps = 0.01;

// ---------------------------------------------------------------------
//  Library (order matters: config needs the parameters above)
// ---------------------------------------------------------------------
include <lib/standards.scad>
include <lib/config.scad>
include <lib/util.scad>
include <lib/fills.scad>
include <lib/adapter.scad>
include <lib/panels.scad>
include <lib/preview.scad>

// ---------------------------------------------------------------------
//  Dispatch
// ---------------------------------------------------------------------
module printable(t) {
    if (print_orientation) translate([0, 0, t]) rotate([90, 0, 0]) children();
    else children();
}

if (part == "assembly") assembly();
else if (part == "adapter") printable(ft) translate([0, 0, -frame_z0]) adapter();
else if (part == "filler" || part == "filler_2") {
    if (filler_mode != "separate") echo("WARNING: filler_mode = integral - the fill is cut into the adapter, no separate filler");
    else if (part == "filler_2" && len(zones) < 2) echo("WARNING: no second spare zone (use spare_pos = split)");
    else if (part == "filler_2") printable(filler_t) filler_panel(zones[1]);
    else if (len(zones) > 0) printable(filler_t) filler_panel(zones[0]);
    else echo("WARNING: no spare zone in this configuration");
}
else if (part == "rack_panel") printable(panel_t) rack_panel();
else if (part == "rack_module_bay") {
    if (!(mod_kind(module_type) == "nkvm" && nk_layout(mod_items(module_type)) == "side" && nkvm_split))
        echo("WARNING: only the split NanoKVM bay (module_type = nkvm:side, nkvm_split = true) has a separate pocket piece");
    else if (print_orientation) rotate([90, 0, 0]) nk_side_bay();
    else nk_side_bay();
}
else if (part == "rack_module" && mod_kind(module_type) == "nkvm" && nk_layout(mod_items(module_type)) == "side" && nkvm_split)
    printable(panel_t) nk_side_plate(nk_n_ks(), [for (i = [0 : max(nk_n_ks(), 1) - 1]) ks_style == "metal" ? "rj45m" : "rj45"],
                                     nk_ks_x0() + nk_ks_w(nk_n_ks()) / 2);
else if (part == "rack_module") {
    // the flat NanoKVM bay prints floor-down with the plate standing; the other modules print face-down
    if (mod_kind(module_type) == "nkvm" && nk_layout(mod_items(module_type)) == "front") rack_module(module_type);
    else printable(panel_t) rack_module(module_type);
}
// multicolour label pieces: the letters of a panel, placed exactly like the panel itself
else if (part == "filler_labels" || part == "filler_2_labels") {
    zn = zones[part == "filler_labels" ? 0 : 1];
    if (zn != undef) printable(filler_t) fill_labels(zn[2], hole_s - R[0] - 6, zn[1] - 0.8, filler_t);
}
else if (part == "rack_panel_labels") printable(panel_t) fill_labels(panel_fill, hole_s - R[0] - 6, panel_u * U - 0.79, panel_t);
else if (part == "rack_module_labels") {
    if (mod_kind(module_type) == "nkvm" && nk_layout(mod_items(module_type)) == "front") module_labels(module_type);
    else printable(panel_t) module_labels(module_type);
}
else if (part == "rack_module_lid") {
    if (mod_kind(module_type) != "nkvm") echo("WARNING: only the NanoKVM bay (module_type = nkvm:side / nkvm:front) has a lid");
    else if (print_orientation) nkvm_lid_print(mod_items(module_type));
    else nkvm_lid(mod_items(module_type));
}
else if (part == "keystone_cover") keystone_cover(cover_type);
else if (part == "pci_bracket") pci_bracket(pci_kind);
else if (part == "test_rack") printable(ft) test_rack();
else if (part == "test_bay") printable(ft) test_bay();
else if (part == "test_keystone") printable(filler_t) test_keystone();
